generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── NextAuth required tables ───────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  password      String?    // hashed — null for OAuth-only users
  accounts      Account[]
  sessions      Session[]
  proposals     Proposal[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App tables ─────────────────────────────────────────────────────────────

model Proposal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Serialized JSON blobs matching the Zod schemas
  input       String   // ProposalInput JSON
  sections    String   // ProposalSection[] JSON
  template    String   // ProposalTemplate JSON

  status      String   @default("draft")
  shareId     String?  @unique
  isPublic    Boolean  @default(false)
  collaborators String @default("[]") // JSON string[]

  viewCount   Int      @default(0)
  exportCount Int      @default(0)
  lastViewedAt DateTime?

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
